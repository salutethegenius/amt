# --- Web (Next.js) ---
# Required for Supabase auth. Get from Supabase project: Connect > Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (for admin operations - KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for email links and Cash N' Go return redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API URL (browser calls this)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Cash N' Go (Paylanes) ---
CNG_MERCHANT_ID=
# Headers API key (apikey) from the merchant dashboard — RAW, not the URL-encoded copy.
# The app URL-encodes it for checkout and sends the same raw value as the API_KEY header.
CNG_API_KEY=
# Auth host. QA: https://paylanes-qa.sprocket.solutions
CNG_BASE_URL=https://paylanes.sprocket.solutions
# HMAC-SHA256 hex of the raw webhook body. Give PayLanes https://<host>/api/webhooks/cng
CNG_WEBHOOK_SECRET=
# Bearer token for GET /api/cron/cng-sync (set on Preview + Production)
CRON_SECRET=

# --- Resend (Email) ---
RESEND_API_KEY=re_...
EMAIL_FROM=A.M.T Imports <billing@your-verified-domain>
ADMIN_EMAIL=ops@your-verified-domain

# --- Importable (Bahamas tariff lookup) ---
# Bearer token from Importable account → API. Server-side only.
IMPORTABLE_API_KEY=

# --- API (FastAPI) ---
# Allowed frontend origins for CORS (comma-separated). Defaults to localhost:3000 and :3001
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: for AI features (LLM, embeddings, Qdrant)
# OPENAI_API_KEY=sk-...
# LLM_API_KEY=...
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=...
